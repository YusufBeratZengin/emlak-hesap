{
  "name": "emlak-hesap",
  "version": "0.1.0",
  "description": "Transparent housing investment and cost calculations for Türkiye, in integer kuruş",
  "type": "module",
  "engines": { "node": ">=20" },
  "license": "MIT",
  "author": "Yusuf Berat Zengin",
  "repository": { "type": "git", "url": "git+https://github.com/YusufBeratZengin/emlak-hesap.git" },
  "homepage": "https://github.com/YusufBeratZengin/emlak-hesap#readme",
  "bugs": { "url": "https://github.com/YusufBeratZengin/emlak-hesap/issues" },
  "keywords": ["real-estate", "mortgage", "rental-yield", "turkey", "kurus", "calculator", "typescript", "finance"],
  "publishConfig": { "access": "public", "provenance": true },
  "sideEffects": false,
  "files": ["dist", "README.md", "README.tr.md", "LICENSE", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./presets/tr-2026": { "types": "./dist/presets/tr-2026.d.ts", "import": "./dist/presets/tr-2026.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "examples": "node examples/rental-yield.mjs && node examples/mortgage.mjs && node examples/purchase-cost.mjs",
    "test:smoke": "npm run build && node tests/node-smoke.test.mjs && npm run examples",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run build:web && npm run check:secrets",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.11",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
